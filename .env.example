# Supabase: pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# Login: npm run hash-passord -- "ditt passord"
APP_PASSWORD_HASH="scrypt:...:..."
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Vercel sends this as a Bearer token to /api/cron/*
CRON_SECRET=""

ANTHROPIC_API_KEY=""

# Read-only inbox check for replies and LinkedIn job alerts (any IMAP server)
IMAP_HOST="imap.example.com"
IMAP_USER="you@example.com"
IMAP_PASSWORD=""

# Daily digest
RESEND_API_KEY=""
DIGEST_TO="you@example.com"
# Needs a domain verified in Resend, e.g. "Jobba <jobba@your-domain.com>"; the default only delivers to the Resend account owner
DIGEST_FROM="Jobba <onboarding@resend.dev>"
APP_URL="http://localhost:3000"

# Local scripts (importer/hent)
SOKNADER_DIR="C:/path/to/your/applications"
